# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (Project Settings → API Keys / Data API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: used only by `npm run admin:create`, never sent to the browser
SUPABASE_SECRET_KEY=
# Optional. Session pooler connection string (with password) lets `npm run db:setup` apply migrations itself;
# without it, run supabase/migrations/*.sql in the Supabase SQL Editor first.
SUPABASE_DB_URL=

# ---- New-order email to the owner (Resend, https://resend.com) ----
# Without RESEND_API_KEY or OWNER_EMAIL the email is only printed to the server log (dry run).
RESEND_API_KEY=
# Comma-separate several addresses. Until a domain is verified in Resend, this must be the
# address the Resend account was created with.
OWNER_EMAIL=
# Optional sender, e.g. "TOTO Orders <orders@your-domain>" once a domain is verified in Resend
ORDER_EMAIL_FROM=

# ---- WhatsApp confirmation to the customer, from the business number (coexistence) ----
# Without these, the confirmation is only printed to the server log (dry run).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template name (Hebrew, language code "he")
WHATSAPP_TEMPLATE_CUSTOMER=order_received
# Shown to customers ("לשאלות: ...")
BUSINESS_PHONE_DISPLAY=058-7160723

# Search engines: hidden until launch. Set to "on" when the site is ready for customers.
SITE_INDEXING=
