# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (Project Settings → API Keys / Data API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: used only by `npm run admin:create`, never sent to the browser
SUPABASE_SECRET_KEY=
# "Connect" → Session pooler connection string, with the DB password filled in. Used only by `npm run db:setup`
SUPABASE_DB_URL=

# ---- WhatsApp Cloud API (Meta Business) — the bot's own number, not the owner's ----
# Without these, orders are only printed to the server log (dry run).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template names (Hebrew, language code "he")
WHATSAPP_TEMPLATE_OWNER=new_order
WHATSAPP_TEMPLATE_CUSTOMER=order_received

# Where new orders go (the owner's WhatsApp) and the number shown to customers
OWNER_WHATSAPP=0587160723
BUSINESS_PHONE_DISPLAY=058-7160723
