# Copy to .env.local and fill in. Without the WhatsApp values, orders are only printed to the server log (dry run).

# WhatsApp Cloud API (Meta Business) — the bot's own number, not the owner's
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template names (Hebrew, language code "he")
WHATSAPP_TEMPLATE_OWNER=new_order
WHATSAPP_TEMPLATE_CUSTOMER=order_received

# Where new orders go (the owner's WhatsApp) and the number shown to customers
OWNER_WHATSAPP=0587160723
BUSINESS_PHONE_DISPLAY=058-7160723
